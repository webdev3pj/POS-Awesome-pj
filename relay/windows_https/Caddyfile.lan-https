# OptiPlex LAN HTTPS relay reverse proxy
# Target URL used by POS browsers on the store LAN:
#   https://192.168.50.168
#
# Caddy provisions a local CA cert with `tls internal`.
# Shop PCs must trust the exported Caddy local root CA certificate once.

https://192.168.50.168 {
    tls internal

    # Relay already emits CORS headers; add only the Private Network Access header here.
    header {
        # Required by modern Chrome for public-site -> private-LAN fetches (PNA).
        Access-Control-Allow-Private-Network "true"
    }

    reverse_proxy 127.0.0.1:8787
}
